exec --no-startup-id ssh-agent -s > ~/.ssh-agent-env
exec --no-startup-id setxkbmap it

# Tasto Modificatore (Mod4 = Tasto Windows / Super)
set $mod Mod4

# Font di sistema
font pango:monospace 13

# Terminale (Kitty)
set $term kitty
bindsym $mod+Return exec $term

# Chiudi la finestra attiva
bindsym $mod+Shift+q kill

# Launcher (dmenu)
#bindsym $mod+d exec --no-startup-id j4-dmenu-desktop
bindsym $mod+d exec --no-startup-id env XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share" rofi -show drun

#file-system
bindsym $mod+shift+n exec --no-startup-id nemo

# Cambia il focus delle finestre (Frecce)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Sposta le finestre (Mod + Shift + Frecce)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout (Orario, Verticale, Schermo Intero)
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

# Ricarica e Riavvia i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# --- Gestione Workspace ---

# Definizione dei nomi dei workspace (1-10)
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Passa al workspace (Mod + Numero)
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Sposta la finestra selezionata nel workspace (Mod + Shift + Numero)
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Barra di stato con i3status-rust
bar {
    status_command i3status-rs ~/.config/i3status-rust/config.toml
}

# Audio - tasti volume (probabilmente già presenti dall'installer CachyOS)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

set $refresh_i3status killall -SIGUSR1 i3status-rs

# Toggle output audio
bindsym $mod+shift+a exec --no-startup-id ~/.config/i3/scripts/toggle-audio-output.sh

# Power menu
bindsym $mod+shift+e exec --no-startup-id ~/.config/rofi/scripts/powermenu.sh

# i3wsr (nomi app nei workspace)
exec_always --no-startup-id i3wsr

#sfondo
exec_always --no-startup-id ~/.fehbg

exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

# BLUE THEME
# class                 border  backgr. text    indicator child_border
client.focused          #321321 #285577 #ffffff #284374   #284374
client.focused_inactive #333333 #5f676a #ffffff #212121   #212121
client.unfocused        #333333 #222222 #888888 #222222   #212121
client.urgent           #2f343a #900000 #ffffff #900000   #900000
client.placeholder      #000000 #0c0c0c #ffffff #000000   #284374

client.background       #284374

gaps inner 10
gaps outer 5
smart_gaps on
